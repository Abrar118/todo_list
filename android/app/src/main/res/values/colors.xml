    <color name="widget_background">#0D1912</color>
    <color name="widget_border">#38EEF6F2</color>
    <color name="widget_text_primary">#ECF4EF</color>
    <color name="widget_text_secondary">#C2D1C8</color>
    <color name="widget_text_muted">#B0BFB6</color>
    <color name="widget_accent">#86E04A</color>
    <color name="widget_overdue">#FF8A7E</color>
    <color name="widget_medium">#C2D1C8</color>
    <color name="widget_low">#C2D1C8</color>
    <color name="widget_on_accent">#0D1912</color>
    <!-- The meadow-at-night ground the app opens onto, so launch has no white flash. -->
    <color name="splash_background">#0D1912</color>
</resources>