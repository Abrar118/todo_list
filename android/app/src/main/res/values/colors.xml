<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Nudge widget palette, mirrors AppColors.dark in lib/core/app_colors.dart.
         Priority is ink, as in the app: high in full ink, medium and low
         in secondary ink. Red is reserved for lateness. -->
    <color name="widget_background">#1D2124</color>
    <color name="widget_border">#29FFFFFF</color>
    <color name="widget_text_primary">#F1F3F5</color>
    <color name="widget_text_secondary">#BCC3C9</color>
    <color name="widget_text_muted">#AEB6BD</color>
    <color name="widget_accent">#F1F3F5</color>
    <color name="widget_overdue">#FF7F73</color>
    <color name="widget_medium">#BCC3C9</color>
    <color name="widget_low">#BCC3C9</color>
    <color name="widget_on_accent">#1D2124</color>
    <color name="ic_launcher_background">#0B0B0D</color>
    <!-- The steel ground the app opens onto, so launch has no white flash. -->
    <color name="splash_background">#1D2124</color>
</resources>