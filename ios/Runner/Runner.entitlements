<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Shared container the widget extension reads WidgetSnapshot JSON from.
	     Must match HomeWidgetService.iosAppGroup and the appGroup constant in
	     NudgeWidgets/NudgeWidgets.swift, and be enabled on both targets in
	     the Apple developer portal. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.abrar118.nudge</string>
	</array>
	<!-- com.apple.developer.usernotifications.time-sensitive is deliberately
	     omitted: free Personal Teams can't sign it. Alarms still request
	     InterruptionLevel.timeSensitive and iOS delivers them as .active (no
	     Focus breakthrough). Re-add <key>…time-sensitive</key><true/> once on
	     a paid Apple Developer Program team. -->
</dict>
</plist>
