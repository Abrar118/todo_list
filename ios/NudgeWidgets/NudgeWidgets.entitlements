<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Same App Group as Runner/Runner.entitlements; the widget reads the
	     WidgetSnapshot JSON the app writes there. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.abrar118.nudge</string>
	</array>
</dict>
</plist>
